generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id // Clerk userId
  email             String   @unique
  firstName         String?
  lastName          String?
  city              String?
  country           String?
  photoUrl          String?
  // New Fields from Settings Screen
  language          String   @default("English (United States)")
  timezone          String   @default("IST (UTC +5:30)")
  savedDestinations String[] // PostgreSQL supports string arrays
  
  trips             Trip[]   
  createdAt         DateTime @default(now())
}

model Trip {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  coverImage  String?
  isPublic    Boolean         @default(false)
  
  // New Fields from Budget and Shared Screens
  totalBudget Float?          
  proTip      String?         @db.Text
  
  stops       Stop[]          
  expenses    Expense[]       
  notes       TripNote[]      
  checklist   ChecklistItem[] 
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Stop {
  id        String     @id @default(uuid())
  tripId    String
  trip      Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityName  String
  startDate DateTime
  endDate   DateTime
  budget    Float?
  
  activities Activity[] 
}

model Activity {
  id          String   @id @default(uuid())
  stopId      String
  stop        Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  title       String
  description String?
  cost        Float    @default(0)
  
  // New Fields from Itinerary Timeline Screen
  type        String   @default("ACTIVITY") // e.g., TRANSPORT, LODGING, ACTIVITY
  startTime   DateTime
  endTime     DateTime?
}

model Expense {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category    String   
  description String
  quantity    Int      @default(1)
  unitCost    Float
  totalAmount Float    
}

model ChecklistItem {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category  String   
  itemName  String
  isPacked  Boolean  @default(false)
}

model TripNote {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  // New Fields from Journal Screen
  title       String
  locationTag String?  // e.g., "Mumbai" or "Surat"
  
  content     String   @db.Text
  date        DateTime @default(now())
}